    {
      "name": "Get Posts",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Test 1: Verify status code is 200",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Test 2: Verify response time is less than 1000ms",
              "pm.test(\"Response time is less than 1000ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);",
              "});",
              "",
              "// Test 3: Verify response is a JSON array",
              "pm.test(\"Response is a JSON array\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('array');",
              "});",
              "",
              "// Test 4: Verify each post has required properties",
              "pm.test(\"Each post has userId, id, title, and body\", function () {",
              "    const jsonData = pm.response.json();",
              "    jsonData.forEach(function(post) {",
              "        pm.expect(post).to.have.property('userId');",
              "        pm.expect(post).to.have.property('id');",
              "        pm.expect(post).to.have.property('title');",
              "        pm.expect(post).to.have.property('body');",
              "    });",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
