              "// Test 2: Verify post id is 1",
              "pm.test(\"Post id is 1\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.id).to.equal(1);",
              "});",
              "",
              "// Test 3: Verify post has required fields",
              "pm.test(\"Post has required fields (userId, id, title, body)\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('userId');",
              "    pm.expect(jsonData).to.have.property('id');",
              "    pm.expect(jsonData).to.have.property('title');",
              "    pm.expect(jsonData).to.have.property('body');",
              "});",
              "",
              "// Test 4: Verify data types",
              "pm.test(\"Data types are valid\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.userId).to.be.a('number');",
              "    pm.expect(jsonData.id).to.be.a('number');",
              "    pm.expect(jsonData.title).to.be.a('string');",
              "    pm.expect(jsonData.body).to.be.a('string');",
              "});"
