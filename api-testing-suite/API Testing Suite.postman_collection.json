              "});\r",
              "\r",
              "// Test 2: Response should be empty object\r",
              "pm.test(\"Response is empty object\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.be.an('object');\r",
              "    // For JSONPlaceholder, DELETE returns empty object\r",
              "});\r",
              "\r",
              "// Test 3: Fast response for DELETE\r",
              "pm.test(\"Fast response time\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(500);\r",
              "});\r",
              "\r",
              "// Test 4: Response headers check\r",
              "pm.test(\"Has content-type header\", function () {\r",
              "    pm.response.to.have.header('Content-Type');\r",
              "});"
